
public class SelectionSort {
    public static void selectionSort(int[] arr){
        int n = arr.length;
        //Outer Loop: In which position the smallest element will now be placed.
        for (int i = 0; i < n -1; i++) {
            //Assume current position contains the minimum.
            int minIndex = i;

            //Inner Loop: Find the smallest element in the remaining array.
            for (int j = i + 1; j < n; j++) {
                if (arr[j] < arr[minIndex]){
                    minIndex= j;
                }
            }
            //Swap the smallest element with arr[i]
            int temp = arr[i];
            arr[i] = arr[minIndex];
            arr[minIndex] = temp;

        }
    }

    public static void main(String[] args) {
        int[] arr ={6,4,2,7,9,15,12};
        selectionSort(arr);
        for (int value : arr){
            System.out.print(value + " ");
        }
    }
}
